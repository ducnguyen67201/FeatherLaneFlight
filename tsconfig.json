{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "react-jsx"
  },
  "include": [
    "packages/contracts/typescript/**/*.ts",
    "src/web/**/*.ts",
    "openapi-ts.config.ts",
    "src/web/**/*.tsx"
  ]
}
