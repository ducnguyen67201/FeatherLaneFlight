  "cards": [
    {
      "dot": "amber",
      "title": "Status and scope",
      "items": [
        "Same architecture and trust boundaries as the first proposal; no hosting change.",
        "P13 and P14 are merged; this candidate consumes actual main 1588e511, including optional usage reporting.",
        "P15 backend/transport is implemented locally and checked; design approved October 29, 2026, not deployed.",
        "Browser adapter/UI is implemented and manually verified locally within the approved scope; not published or deployed."
      ]
    },
    {
      "dot": "violet",
      "title": "Bounded storage and delivery",
      "items": [
        "One logical 500 MiB managed runner budget: 64 events + 435 evidence + 1 accounting.",
        "At most 32 reservations / 4 contents each; reserve full copies before bytes, release after removal.",
        "P14 raw original 128 B stays charged until P14 proves ownership and removes it.",
        "Identity/process metadata and uncontrolled host files are outside this logical budget.",
        "Batches 100 events / 256 KiB; server event log at most 10,000 observations per run."
      ]
    },
    {
      "dot": "rose",
      "title": "Authority and truthful cleanup",
      "items": [
        "Runner writes require current P13 auth, attempt, lease, fence and accepted manifest.",
        "P14 shared expiry includes cancellation deadlines; expired writes cannot revive an attempt.",
        "Spool exhaustion calls the real P14 stop interface; child/group/cleanup flags remain explicit.",
        "Events cannot free capacity, prove cleanup or publish COMPLETED/PASS. P14/P17 own those gates."
      ]
    },
    {
      "dot": "cyan",
      "title": "Recovery and browser policy",
      "items": [
        "Current session and both memberships protect every JSON/SSE read.",
        "Signed run-scoped cursors, consistent locked snapshots, JSON 410 and open-stream reset.",
        "At most 8 process-local streams, 30 s rotation; comments carry no domain data.",
        "Validated framing/reconnect only; no second browser lifecycle machine or raw telemetry.",
        "No new runtime qualification: NON_EXECUTING stays disabled / declared."
      ]
    }
  ]
