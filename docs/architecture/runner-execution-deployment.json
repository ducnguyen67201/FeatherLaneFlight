  "cards": [
    {
      "dot": "cyan",
      "title": "Delivery order",
      "items": [
        "1. Review the architecture and UI, then implement bounded increments locally with fake provisioning.",
        "2. Qualify the pinned Linux runtime, private build input path and lifecycle/cleanup behavior.",
        "3. Approve exact staging resources, region, networking and spend ceiling before provisioning.",
        "4. Exercise both supported paths, then approve a capped private pilot with monitoring and rollback."
      ]
    },
    {
      "dot": "rose",
      "title": "Execution boundary",
      "items": [
        "One attempt per fresh VM; PX4/SIH and the scenario adapter run inside the guest.",
        "No database, provider-admin or reusable runner credentials in the guest.",
        "The trusted controller stops failed guests; a separate reconciler reaps orphan VMs and scratch storage."
      ]
    },
    {
      "dot": "amber",
      "title": "Pilot and rollback",
      "items": [
        "Start with one region and bounded concurrency, runtime, storage and usage allowances.",
        "Paid pricing and billing are separate work; no automatic overage.",
        "Rollback stops new admission, drains or cancels active attempts and confirms teardown before restoring a compatible app/image.",
        "Topology is proposed; account, region, instance size and deployment are not approved or provisioned."
      ]
    }
  ]
