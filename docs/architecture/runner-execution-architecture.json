  "cards": [
    {
      "dot": "amber",
      "title": "🟡 Phase 08 — implemented for review",
      "items": [
        "UI slice: optional machine enrollment, health/connectivity/capacity and revocation.",
        "API/data slice: one-use grants, project-bound runner credentials, response-loss recovery, version checks and revocation.",
        "Agent slice: secure local identity, idle heartbeats and references to available builds/profiles. Detailed registrations belong to P09.",
        "Yellow markers identify only the P08 slices. Architecture and shown UI were approved October 29, 2026; phase submission is separately gated."
      ]
    },
    {
      "dot": "cyan",
      "title": "Cloud path · default",
      "items": [
        "The website admits one project-scoped job with an immutable supported build and suite.",
        "The trusted controller holds runner identity outside the guest and controls VM termination.",
        "Each attempt gets a fresh simulation guest and expiring evidence-only access."
      ]
    },
    {
      "dot": "emerald",
      "title": "Customer machine · optional",
      "items": [
        "Install and qualify the local runtime, then enroll using a one-use project grant.",
        "The runner polls outbound HTTPS; approved local settings launch PX4 and MAVSDK.",
        "Executables stay on the machine; metadata and policy-permitted evidence return."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and scope",
      "items": [
        "Both execution paths converge on the same evidence validation, evaluation and results.",
        "Worker observations are untrusted inputs, not safety certification or an authoritative PASS.",
        "Architecture approved October 29, 2026; this execution subsystem includes future services that are not implemented or deployed. See docs/architecture/runner-execution.md."
      ]
    },
    {
      "dot": "slate",
      "title": "Later phases — context only",
      "items": [
        "Cloud allocation, VM startup and teardown, local installer, simulator installation and actual PX4 test execution are outside P08.",
        "Claims/leases, test events/evidence, evaluation and managed build upload are later scoped work.",
        "The cloud controller remains unhighlighted: P08 common identity rules do not implement the controller or provision cloud machines."
      ]
    }
  ]
